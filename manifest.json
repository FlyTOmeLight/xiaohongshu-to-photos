{
  "manifest_version": 3,
  "name": "红薯收藏夹",
  "description": "从小红书网页版选择原图、GIF 和实况照片，并直接保存到 macOS“照片”App。",
  "version": "1.2.7",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "*://*.xiaohongshu.com/*",
    "*://*.xhscdn.com/*",
    "*://*.xhscdn.net/*"
  ],
  "action": {
    "default_title": "保存小红书图片",
    "default_popup": "popup.html"
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "*://*.xiaohongshu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
